{
  "name": "halka",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --android --go --port 8081",
    "ios": "expo run:ios",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web --go --port 8081",
    "web:setup": "mkdir -p public && cp node_modules/canvaskit-wasm/bin/full/canvaskit.wasm public/canvaskit.wasm",
    "dev": "expo start --go --port 8081",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "expo prebuild --platform android --clean",
    "android:dev": "expo run:android",
    "verify": "npm run typecheck && npm test && npm run lint"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@shopify/react-native-skia": "2.0.0-next.4",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-audio": "~0.4.9",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-keep-awake": "~14.1.4",
    "expo-localization": "~16.1.6",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-google-mobile-ads": "15.8.3",
    "react-native-reanimated": "~3.17.4",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3"
  }
}
